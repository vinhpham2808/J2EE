# =============================================================
# Dockerfile.api — Chạy Spring Boot với profile "api"
# Container này: REST API + Security + AI features
#                KHÔNG chạy @Scheduled jobs
# Build: docker build -f Dockerfile.api -t moneymanager-api .
# =============================================================

# Stage 1: Build
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app

# Cache dependencies trước (chỉ re-download khi pom.xml thay đổi)
COPY Backend/moneymanager/pom.xml ./pom.xml
RUN mvn dependency:resolve dependency:resolve-plugins -q

# Build JAR
COPY Backend/moneymanager/src ./src
RUN mvn clean package -DskipTests -q

# Stage 2: Runtime
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Metadata
LABEL service="moneymanager-api"
LABEL profile="api"
LABEL description="REST API server — no scheduled jobs"

# Copy JAR từ build stage
COPY --from=build /app/target/*.jar app.jar

# JVM flags tối ưu cho production EC2 (web-api instances):
# -XX:+UseG1GC         = G1GC phù hợp cho web server có nhiều request/response
# -Xmx512m             = Tăng heap cho API (có nhiều request concurrent)
# -XX:MaxRAMPercentage = Cap heap theo RAM container
ENV JAVA_OPTS="-XX:+UseG1GC -Xmx512m -XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8"

# Spring profile = api
ENV SPRING_PROFILES_ACTIVE=api

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:8080/api/v1.0/health || exit 1

CMD ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
